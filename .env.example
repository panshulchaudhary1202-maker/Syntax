# Server port for local development / Render.
PORT=3000
# Use the Supabase PostgreSQL URI (Session pooler). Keep the password private.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Exact allowed campus email domain; subdomains such as cs.iitr.ac.in are also accepted.
ALLOWED_EMAIL_DOMAIN=iitr.ac.in
# Google OAuth Web client ID (looks like 123456-abc.apps.googleusercontent.com). Not secret.
GOOGLE_CLIENT_ID=
# Keep true: only Google accounts managed by the IITR domain can sign in.
# Set to false only if testing shows real IITR accounts are rejected (see README).
GOOGLE_REQUIRE_HOSTED_DOMAIN=true
# Set true when hosted behind one trusted reverse proxy such as Render; enables secure proxy cookies.
TRUST_PROXY=false
# Set true only when your proxy terminates HTTPS and forwards protocol information.
COOKIE_SECURE=false
# openrouteservice (HeiGIT) API key for maps. Stays on the server; the browser never sees it.
ORS_API_KEY=
